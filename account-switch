#!/usr/bin/env python3
"""Discover Claude Code accounts and switch the active one.

Candidates come from host home directories, Docker containers, and this tool's own
switch backups. Copies of the same account are merged by credential expiresAt and
the freshest copy is the one that gets installed.

Safety rules:
  * Only account metadata and whether a token is non-empty are ever printed.
    Token contents are never printed, never logged, and never passed as argv.
  * The current state is backed up first; the target file is replaced atomically
    via a same-directory temp file plus os.replace.
  * Claude is never invoked and the network is never touched. Usage figures and
    refresh times come from the local cache only, so they can be stale.
"""

from __future__ import annotations

